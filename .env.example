# Segredo compartilhado entre o gateway B2C e o backend (o gateway envia no header X-Gateway-Secret)
GATEWAY_SHARED_SECRET=troque-por-um-segredo-longo-e-aleatorio

# Porta (plataformas como Render/Railway/Heroku definem PORT automaticamente)
PORT=8080

# Somente em produção
SPRING_PROFILES_ACTIVE=prod
DATABASE_URL=jdbc:postgresql://HOST:5432/NOME_DO_BANCO
DATABASE_USER=usuario
DATABASE_PASSWORD=senha
