# Segredo compartilhado entre o gateway B2C e o backend (o gateway envia no header X-Gateway-Secret)
GATEWAY_SHARED_SECRET=troque-por-um-segredo-longo-e-aleatorio

# Porta (plataformas como Render/Railway/Heroku definem PORT automaticamente)
PORT=8080

# Somente em produção
SPRING_PROFILES_ACTIVE=prod
DATABASE_URL=jdbc:postgresql://HOST:5432/NOME_DO_BANCO
DATABASE_USER=usuario
DATABASE_PASSWORD=senha

# Gateway
KEYCLOAK_URL=http://localhost:8180
KEYCLOAK_REALM=locadora
KEYCLOAK_CLIENT_ID=locadora-api
KEYCLOAK_ADMIN_CLIENT_ID=gateway-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=troque-por-um-segredo-longo-e-aleatorio
BACKEND_URL=http://localhost:8080
RATE_LIMIT_AUTH_PER_MINUTE=5
RATE_LIMIT_API_PER_MINUTE=60
RATE_LIMIT_TRUST_XFF=false
CORS_ALLOWED_ORIGINS=*
# GATEWAY_SHARED_SECRET já existe: deve ser IGUAL no gateway e no backend
